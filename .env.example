# Copy to .env and fill in the blanks before running anything.
# See docs/operations.md for the runbook and plans/m4-network.md for where
# these values come from.
#
# Every secret here is deliberately empty. Non-secret configuration
# (hostnames, ports, paths) carries its real value, because getting it
# wrong is a support call and there is nothing to protect. Never commit a
# filled-in .env — see docs/data-and-privacy.md.
#
# Service variables (translation, transcription, audio source) are added
# as each milestone lands; this file currently covers the network layer
# only.

# --- Public hostnames (ADR 0003, plans/m4-network.md) ---

# Student caption pages. Open to the classroom: no credentials, reached
# with an unguessable lesson id.
ECO_PUBLIC_HOST=rev-babel.emiliovicari.com

# The teacher's audio capture page. This one opens a microphone in a room
# full of people, so it is protected — Cloudflare Access, or the bearer
# token below, or both.
ECO_CAPTURE_HOST=mic.emiliovicari.com

# --- Cloudflare Tunnel ---

# The tunnel is managed from the Cloudflare dashboard, so its routing and
# its credentials live there and in the systemd unit written by
# `cloudflared service install <TOKEN>` — not here. Nothing to fill in;
# see infra/tunnel/README.md. The connector token is a secret and must
# never be committed.

# --- Web app ---

# The app binds to loopback only; cloudflared is the sole way in.
WEB_BIND=127.0.0.1
WEB_PORT=8000

# Signing key for the lesson-scoped session cookie (ADR 0010).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Bearer token guarding the capture endpoint. Rotate per lesson.
CAPTURE_TOKEN=
