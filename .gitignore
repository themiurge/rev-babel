# Personal data — never commit
data/*
!data/.gitkeep
!data/README.md
.env
*.wav
*.mp3
*.ogg
*.webm
models/
*.db
cert.pem
infra/tunnel/*.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Scratchpad runtime
scratchpad/token.txt
scratchpad/captures/
scratchpad/listen/

# Pyodide (lesson 7) is fetched by scripts/fetch-pyodide.py, not committed
apps/web/static/vendor/pyodide/*
!apps/web/static/vendor/pyodide/README.md
!apps/web/static/vendor/pyodide/SHA256SUMS
!apps/web/static/vendor/pyodide/LICENSE
